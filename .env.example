# ANVAYA configuration template — placeholders only.
# Copy to .env locally. Never commit real credentials or personal information.

ANVAYA_ENV=development
ANVAYA_DATABASE_URL=sqlite:///anvaya_local.db
ANVAYA_AUTH_ADAPTER=prototype
ANVAYA_OPTIONAL_LLM_ENABLED=false
ANVAYA_OPTIONAL_LLM_API_KEY=
ANVAYA_DEMO_PASSWORD=ANVAYA-DEMO-ONLY-2026
ANVAYA_PUBLIC_DEMO_MODE=false
ANVAYA_SESSION_TTL_MINUTES=60
ANVAYA_MAX_SEARCH_RESULTS=25
ANVAYA_MAX_REQUEST_BYTES=1048576
ANVAYA_MAX_UPLOAD_BYTES=524288
ANVAYA_LOGIN_RATE_LIMIT_PER_MINUTE=10
ANVAYA_HTTPS_ENABLED=false
ANVAYA_TRUST_PROXY=false

# Production: set a unique 32+ character value outside Git and use HTTPS origins.
# Leave blank for local development; production startup deliberately fails without it.
ANVAYA_SESSION_SECRET=
ANVAYA_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# M7.1 Catalyst compatibility switches. All defaults preserve local SQLite/prototype mode.
# These are identifiers/placeholders only; do not put credentials or a real credentials path in Git.
ANVAYA_STORAGE_BACKEND=sqlite
ANVAYA_AUTH_BACKEND=prototype
ANVAYA_ARTIFACT_STORAGE=local
ANVAYA_CATALYST_ENABLED=false
ANVAYA_CATALYST_PROJECT_ID=
ANVAYA_CATALYST_ENVIRONMENT=
ANVAYA_CATALYST_API_BASE=
ANVAYA_CATALYST_SERVICE_ACCOUNT_EMAIL=
ANVAYA_CATALYST_CREDENTIALS_PATH=
ANVAYA_CATALYST_DATASTORE_ENABLED=false
ANVAYA_CATALYST_AUTH_ENABLED=false
ANVAYA_CATALYST_FILE_STORAGE_ENABLED=false

# Configurable synthetic-source freshness thresholds in hours
ANVAYA_FRESHNESS_CCTNS_HOURS=720
ANVAYA_FRESHNESS_FORENSICS_HOURS=336
ANVAYA_FRESHNESS_VEHICLE_HOURS=720
ANVAYA_FRESHNESS_CONTEXT_HOURS=4320
