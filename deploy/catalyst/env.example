# Docker Custom Runtime AppSail example. All values are placeholders; do not commit secrets or live identifiers.
ANVAYA_ENV=production
ANVAYA_STORAGE_BACKEND=sqlite
ANVAYA_AUTH_BACKEND=prototype
ANVAYA_ARTIFACT_STORAGE=local
ANVAYA_CATALYST_ENABLED=false
ANVAYA_CATALYST_DATASTORE_ENABLED=false
ANVAYA_CATALYST_AUTH_ENABLED=false
ANVAYA_CATALYST_FILE_STORAGE_ENABLED=false
ANVAYA_ALLOWED_ORIGINS=https://replace-with-exact-appsail-url.example
ANVAYA_HTTPS_ENABLED=true
ANVAYA_TRUST_PROXY=true
ANVAYA_SESSION_SECRET=REPLACE_LOCALLY_WITH_32_PLUS_RANDOM_CHARACTERS
ANVAYA_DEMO_PASSWORD=REPLACE_LOCALLY_WITH_24_PLUS_RANDOM_CHARACTERS
ANVAYA_PUBLIC_DEMO_MODE=true

# ── Optional AI Assist (OpenRouter free tier) ────────────────────────────────
# Set both vars to enable LLM-assisted query interpretation and grounded answers.
# If either is missing, ANVAYA falls back to the deterministic parser automatically.
# Free-tier note: OpenRouter accounts without credits are typically ~50 req/day.
# Prefer openrouter/free + :free model fallbacks; do not use paid model IDs here.
ANVAYA_AI_ASSIST_ENABLED=true
ANVAYA_OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
ANVAYA_OPENROUTER_BASE=https://openrouter.ai/api/v1
ANVAYA_OPENROUTER_MODEL=openrouter/free
ANVAYA_OPENROUTER_FALLBACK_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,qwen/qwen3-8b:free
ANVAYA_OPENROUTER_TIMEOUT_SECONDS=6

# ── Optional Voice / Translation (Sarvam AI) ─────────────────────────────────
# Set both vars to enable server-side Kannada/Hindi/English STT, TTS, and translation.
# Browser mic falls back to browser SpeechRecognition when this is disabled.
ANVAYA_VOICE_ENABLED=true
ANVAYA_SARVAM_API_KEY=REPLACE_WITH_SARVAM_API_KEY
ANVAYA_SARVAM_BASE=https://api.sarvam.ai
ANVAYA_SARVAM_STT_MODEL=saaras:v3
ANVAYA_SARVAM_TTS_MODEL=bulbul:v3
ANVAYA_SARVAM_TRANSLATE_MODEL=mayura:v1
ANVAYA_SARVAM_TIMEOUT_SECONDS=15

# This final deployment intentionally uses ephemeral synthetic SQLite workflow
# state inside the AppSail container. Catalyst Data Store and Catalyst
# Authentication are not wired for the final prototype; they must not be claimed.
