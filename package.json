{
  "name": "anvaya-local-foundation",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "python -m flask --app backend.wsgi run --debug --port 5000",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "seed:test": "python -m scripts.seed_data --scale test --reset",
    "seed:full": "python -m scripts.seed_data --scale full --reset",
    "db:reset": "python -m scripts.seed_data --scale test --reset",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "python -m pytest backend/tests",
    "test:frontend": "npm --prefix frontend run test -- --run"
  },
  "devDependencies": {
    "concurrently": "9.1.2"
  }
}
